    "@supabase/supabase-js": "^2.81.1",
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "envalid": "^8.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "graphql": "^16.12.0",

{
  // Build-only config: same as tsconfig.json but excludes test files so they are
  // never emitted to dist. Used by `yarn build` (tsc + tsc-alias).
  "extends": "./tsconfig.json",
  "include": ["src/**/*", "prisma/seed/**/*", "prisma.config.ts"],
  "exclude": ["node_modules", "dist", "vitest.config.ts", "src/**/*.test.ts"]
}
